# Database
DATABASE_URL="file:./prisma/dev.db"

# GitHub Integration (Personal Access Token with repo + workflow scopes)
GITHUB_TOKEN=ghp_your_token_here

# Vercel Integration (API Token from Vercel account settings)
VERCEL_TOKEN=your_vercel_token_here

# Webhook Secret (for verifying GitHub webhook payloads)
WEBHOOK_SECRET=your_webhook_secret_here

# JWT Secret (for authentication)
JWT_SECRET=your_jwt_secret_here

# CORS Origin (for API to communicate with web app)
CORS_ORIGIN=http://localhost:3000

# Turbo Remote Cache (optional)
TURBO_TOKEN=
TURBO_TEAM=
